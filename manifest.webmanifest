{
  "name": "Đánh dấu PDF – Ghi chú vị trí & ảnh hiện trường",
  "short_name": "Đánh dấu PDF",
  "description": "Đánh dấu vị trí cần ghi chú trên bản vẽ PDF, gắn ảnh hiện trường, xuất PDF tổng hợp.",
  "lang": "vi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
